{
  "name": "themba",
  "version": "1.0.0",
  "private": true,
  "description": "Themba community wealth platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "esbuild scripts/dashboard.js --bundle --platform=browser --format=iife --minify --outfile=scripts/dashboard.bundle.js && esbuild scripts/safe-panel.js --bundle --platform=browser --format=iife --minify --outfile=scripts/safe-panel.bundle.js",
    "check": "node --check src/server.js && node --check src/data/demo-data.js && npm run build",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@safe-global/api-kit": "^5.0.4",
    "@safe-global/protocol-kit": "^8.0.11",
    "buffer": "^6.0.3",
    "dotenv": "^18.0.10",
    "ethers": "^6.17.0",
    "express": "^5.1.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
